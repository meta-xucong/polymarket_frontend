{
  "name": "polymarket-panel-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Android shell for Polymarket integrated panel",
  "scripts": {
    "env:print": "node -e \"console.log('JAVA_HOME=' + (process.env.JAVA_HOME || '')); console.log('ANDROID_SDK_ROOT=' + (process.env.ANDROID_SDK_ROOT || process.env.ANDROID_HOME || ''));\"",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug",
    "android:build:release": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "typescript": "^5.6.3"
  }
}
