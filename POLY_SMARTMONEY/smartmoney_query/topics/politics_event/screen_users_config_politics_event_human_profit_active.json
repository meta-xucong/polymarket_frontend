{
  "extends": "../../screen_users_config_politics_event_specialist.json",
  "_comment_extends": "Politics screen for profitable, recently active, non-HFT, human-like event traders",
  "data_dir": "topics/politics_event/data",
  "users_dir": "topics/politics_event/data/users",
  "output_dir": "topics/politics_event/data",
  "official_market_meta_cache_filename": "topics/politics_event/data/official_market_meta_cache.json",

  "filters": {
    "min_closed_count": 15,
    "min_account_age_days": 120,
    "min_lifetime_realized_pnl": 0,

    "min_political_condition_ratio": 0.60,
    "min_recent_political_condition_ratio": 0.58,
    "max_hedge_condition_ratio": 0.40,

    "min_recent_closed_count": 3,
    "min_recent_action_count": 10,
    "min_recent_condition_count": 4,
    "min_recent_active_days": 4,
    "min_recent_trades_per_day": 0.18,
    "max_last_trade_days_ago": 14,

    "min_bayes_win_rate": 0.52,
    "min_median_roi": 0.0,
    "min_stability_score": 0.16,
    "max_max_drawdown_ratio": 0.85,
    "max_pnl_top1_day_share": 0.88,

    "max_trades_per_day": 60,
    "max_daily_trades": 220,
    "max_minute_burst_ratio": 0.55,
    "min_interval_median_minutes": 0.20,

    "max_tail_high_ratio": 0.95,
    "max_tail_low_ratio": 0.80,
    "min_mid_ratio": 0.03
  },

  "specialist_relief": {
    "min_topic_ratio": 0.62,
    "min_recent_topic_ratio": 0.58,
    "min_recent_actions": 14,
    "min_lifetime_pnl": 0.0,
    "max_hedge_ratio": 0.42,
    "stability_floor_delta": 0.05,
    "max_trades_multiplier": 1.6,
    "max_daily_trades_multiplier": 2.0,
    "max_minute_burst_ratio_multiplier": 1.2,
    "max_pnl_top1_day_share_multiplier": 1.08
  },

  "label_rules": {
    "copy_style": {
      "minute_burst_ratio_high": 0.45,
      "interval_median_minutes_fast": 2,
      "trades_per_day_high": 45,
      "burstiness_high": 6,
      "near_expiry_ratio_high": 0.35
    }
  }
}
